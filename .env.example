# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# App & Deployment Configuration
# In production, NEXT_PUBLIC_APP_URL (or NEXT_PUBLIC_SITE_URL) MUST be set to your public HTTPS domain (e.g. https://propertyledge.com).
# In development, it defaults to http://localhost:3000 if not specified.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEBUG=true

# Bank Deposit Account Details (For Customer Checkout Direct Deposits)
NEXT_PUBLIC_BANK_ACCOUNT_NAME=PROPERTYLEDGE PTY LTD
NEXT_PUBLIC_BANK_NAME=National Australia Bank (NAB)
NEXT_PUBLIC_BANK_BSB=083-004
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=9876 54321
NEXT_PUBLIC_BANK_REFERENCE_PREFIX=PL-2026-

# Resend Email Integration (Server-only)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=PropertyLedge

# Optional: Redirect all outgoing emails to your personal/Resend account email during testing (when no custom domain is verified)
EMAIL_REDIRECT_TO=

# Administrative & Notification Configuration (Server-only)
ADMIN_NOTIFY_EMAIL=admin@propertyledge.com.au
ADMIN_EMAILS=admin@propertyledge.com,admin@propertyledge.com.au
ADMIN_USER_IDS=

# Billing Webhook Secret (Server-only)
BILLING_WEBHOOK_SECRET=whsec_your_billing_webhook_secret_here
